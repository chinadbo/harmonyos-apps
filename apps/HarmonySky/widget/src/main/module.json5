{
  "module": {
    "name": "widget",
    "type": "feature",
    "description": "HarmonySky 桌面月相卡片模块",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "extensionAbilities": [
      {
        "name": "MoonWidget",
        "srcEntry": "./ets/MoonWidget.ets",
        "type": "form",
        "exported": true
      }
    ],
    "metadata": [
      {
        "name": "ohos.extension.form",
        "resource": "$profile:form_config"
      }
    ],
    "requestPermissions": []
  }
}
